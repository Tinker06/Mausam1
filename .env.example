# MAUSAM Environment Configuration Example
# Copy this file to .env for local environment setup

# Application Settings
APP_NAME=MAUSAM
DEBUG=True
PORT=8000

# Weather API Keys (Open-Meteo is open access and used by default; set key if using OpenWeatherMap)
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Database Settings
DATABASE_URL=sqlite+aiosqlite:///./mausam.db

# Firebase Web App SDK Config (From Firebase Console -> Project Settings -> General -> Your Apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK Config (From Firebase Console -> Service Accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=
FCM_ENABLED=false
